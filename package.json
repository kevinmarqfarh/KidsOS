{
  "name": "kidsos",
  "version": "1.0.0",
  "description": "KidsOS – ett lärande, touch-först 'operativsystem' för barn 4–10 år (svenska, Lgr22-förankrat).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "node scripts/gen-images.mjs && node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "docs": "node scripts/docs.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright-core": "1.56.1"
  }
}
